<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CommunitiesForever.Upload.App.Controls"
        xmlns:v="using:CommunitiesForever.Upload.App.Views"
        xmlns:vm="using:CommunitiesForever.Upload.App.ViewModels"
        x:Class="CommunitiesForever.Upload.App.Views.WatchedAccountsWindow"
        x:DataType="vm:WatchedAccountsViewModel"
        Title="Watched accounts"
        Icon="/Assets/Icons/app.ico"
        Width="{StaticResource AppDialogW}" Height="{StaticResource AppDialogH}"
        MinWidth="{StaticResource AppWindowMinW}" MinHeight="{StaticResource AppWindowMinH}"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">
  <!-- "Change…" in the main window: setup step 2 on its own (board setup), Save and Cancel (docs/DESIGN-NOTES.md) -->
  <Border BorderBrush="{StaticResource AppLineWindowBrush}" BorderThickness="{StaticResource BorderThickness}">
    <DockPanel>
      <c:TitleBar DockPanel.Dock="Top" />
      <DockPanel Margin="{StaticResource AppSetupMainPad}">
        <Border Classes="footer" DockPanel.Dock="Bottom">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource S2_5}">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding Find.CanContinue}" />
          </StackPanel>
        </Border>
        <v:FindGameView DataContext="{Binding Find}" />
      </DockPanel>
    </DockPanel>
  </Border>
</Window>

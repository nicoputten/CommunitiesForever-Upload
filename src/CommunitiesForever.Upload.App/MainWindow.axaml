<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CommunitiesForever.Upload.App.Controls"
        xmlns:vm="using:CommunitiesForever.Upload.App.ViewModels"
        xmlns:v="using:CommunitiesForever.Upload.App.Views"
        x:Class="CommunitiesForever.Upload.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title, FallbackValue='CommunitiesForever Uploader'}"
        Icon="/Assets/Icons/app.ico"
        Width="{StaticResource AppWindowW}" Height="{StaticResource AppWindowH}"
        MinWidth="{StaticResource AppWindowMinW}" MinHeight="{StaticResource AppWindowMinH}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">
  <!-- Board: design/boards/main-window; status states: design/boards/states (UP-07) -->
  <Border BorderBrush="{StaticResource AppLineWindowBrush}" BorderThickness="{StaticResource BorderThickness}">
    <DockPanel>
      <c:TitleBar Name="Bar" DockPanel.Dock="Top" />

      <!-- Status bar (not on the settings page, as on the settings board) -->
      <Border Classes="statusbar" DockPanel.Dock="Bottom" IsVisible="{Binding !IsSettingsOpen}">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource S1_5}">
            <TextBlock Classes="meta fresh" Classes.warn="{Binding !IsConnected}" Text="●" />
            <TextBlock Classes="meta" Text="{Binding ConnectedText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource S3_5}">
            <!-- Retail test mode (docs/RETAIL-TEST-MODE.md) -->
            <Border Classes="pill gold" VerticalAlignment="Center" IsVisible="{Binding RetailTestMode}">
              <TextBlock VerticalAlignment="Center" Text="{x:Static vm:MainViewModel.RetailTestText}" />
            </Border>
            <!-- Once after an update (update-states board) -->
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource S2}" IsVisible="{Binding HasUpdatedTo}">
              <Border Classes="pill gold">
                <StackPanel Orientation="Horizontal">
                  <TextBlock VerticalAlignment="Center" Text="{Binding UpdatedTo}" />
                  <Button Classes="link fine" Content="What's new" Command="{Binding OpenWhatsNewCommand}" />
                </StackPanel>
              </Border>
              <Button Classes="link dim" Content="✕" Command="{Binding DismissUpdatedCommand}" AutomationProperties.Name="Close" ToolTip.Tip="Close" />
            </StackPanel>
            <TextBlock Classes="meta" VerticalAlignment="Center" Text="Starts with Windows" IsVisible="{Binding StartsWithWindows}" />
            <Button Classes="link" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings">
              <StackPanel Orientation="Horizontal" Spacing="{StaticResource S1_5}">
                <Viewbox Width="{StaticResource AppGearIcon}" Height="{StaticResource AppGearIcon}">
                  <Canvas Width="{StaticResource AppGearIconBox}" Height="{StaticResource AppGearIconBox}">
                    <Path Data="M10.5,8 A2.5,2.5 0 1 1 5.5,8 A2.5,2.5 0 1 1 10.5,8 Z M8,1 V3 M8,13 V15 M1,8 H3 M13,8 H15 M3,3 L4.4,4.4 M11.6,11.6 L13,13 M3,13 L4.4,11.6 M11.6,4.4 L13,3"
                          Stroke="{StaticResource GoldBrush}" StrokeThickness="{StaticResource AppGearIconStroke}" />
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Settings (UP-09) -->
      <ContentControl Content="{Binding Settings}" IsVisible="{Binding IsSettingsOpen}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:SettingsViewModel">
            <v:SettingsView />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <Grid Margin="{StaticResource S5Thickness}" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource S4}" IsVisible="{Binding !IsSettingsOpen}">
        <StackPanel Spacing="{StaticResource S4}">

          <!-- Status header -->
          <Border Classes="hero" Classes.warn="{Binding Hero.IsWarn}" AutomationProperties.LiveSetting="Polite">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource S5}">
              <Panel Width="{StaticResource AppHeroIcon}" Height="{StaticResource AppHeroIcon}" VerticalAlignment="Center">
                <!-- The pulse grows from the shield's centre (Styles/Motion.axaml animates the ScaleTransform) -->
                <Ellipse Classes="ring" RenderTransformOrigin="50%,50%" IsVisible="{Binding Hero.IsCalm}">
                  <Ellipse.RenderTransform>
                    <ScaleTransform />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Classes="ring late" RenderTransformOrigin="50%,50%" IsVisible="{Binding Hero.IsCalm}">
                  <Ellipse.RenderTransform>
                    <ScaleTransform />
                  </Ellipse.RenderTransform>
                </Ellipse>
                <!-- Required update: the update arrows instead of the shield (update-states board) -->
                <Viewbox Width="{StaticResource AppUpdateArrows}" Height="{StaticResource AppUpdateArrows}" IsVisible="{Binding Hero.IsUpdateNeeded}">
                  <Canvas Width="{StaticResource AppUpdateArrowsBox}" Height="{StaticResource AppUpdateArrowsBox}">
                    <Path Data="M27,17 A10,10 0 1 1 24,9.9 M27,6 V12 H21" Stroke="{StaticResource StaleTextBrush}"
                          StrokeThickness="{StaticResource AppUpdateArrowsStroke}" StrokeLineCap="Round" StrokeJoin="Round" />
                  </Canvas>
                </Viewbox>
                <!-- The board's 26 x 26 icon box, scaled: keeps the shield centred in the rings -->
                <Viewbox IsVisible="{Binding Hero.ShowsShield}">
                  <Canvas Width="{StaticResource AppShieldBox}" Height="{StaticResource AppShieldBox}">
                    <Path Data="M13,3 L21,6.5 V13 C21,18.4 17.4,21.2 13,23 C8.6,21.2 5,18.4 5,13 V6.5 Z M13,7.5 V18.5 M8.8,12 H17.2"
                          Fill="{StaticResource SurfaceRaisedBrush}" Stroke="{StaticResource GoldBrightBrush}"
                          StrokeThickness="{StaticResource AppShieldStroke}" />
                  </Canvas>
                </Viewbox>
              </Panel>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource S1}">
                <TextBlock Classes="status"
                           Classes.fresh="{Binding Hero.Tone, Converter={x:Static c:Tones.Fresh}}"
                           Classes.gold="{Binding Hero.Tone, Converter={x:Static c:Tones.Gold}}"
                           Classes.playing="{Binding Hero.Tone, Converter={x:Static c:Tones.Playing}}"
                           Classes.dim="{Binding Hero.Tone, Converter={x:Static c:Tones.Dim}}"
                           Classes.warn="{Binding Hero.Tone, Converter={x:Static c:Tones.Warn}}"
                           Text="{Binding Hero.Status}" />
                <TextBlock Classes="hero-title" Text="{Binding Hero.Title}" />
                <TextBlock Classes="body-sm" TextWrapping="Wrap" Text="{Binding Hero.Line}" IsVisible="{Binding Hero.Line.Length}" />
                <Border Classes="bar" IsVisible="{Binding Hero.Uploading}" Margin="{StaticResource AppFooterPad}">
                  <Border Classes="fill" HorizontalAlignment="Stretch" RenderTransformOrigin="0%,50%" RenderTransform="scaleX(0.6)" />
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="{StaticResource S2}">
                <Button Classes="primary" Content="Restart and update" Command="{Binding RestartToUpdateCommand}" IsVisible="{Binding Hero.ShowRestartToUpdate}" />
                <Button Classes="primary" Content="Upload now" Command="{Binding UploadNowCommand}" IsVisible="{Binding Hero.ShowUploadNow}" />
                <Button Classes="primary" Content="Try now" Command="{Binding TryNowCommand}" IsVisible="{Binding Hero.ShowTryNow}" />
                <Button Classes="primary" Content="Reconnect" Command="{Binding ReconnectCommand}" IsVisible="{Binding Hero.ShowReconnect}" />
                <Button Classes="primary" Content="Scan again" Command="{Binding ScanAgainCommand}" IsVisible="{Binding Hero.ShowFindGame}" />
                <Button Content="Choose folder…" Command="{Binding ChooseFolderCommand}" IsVisible="{Binding Hero.ShowFindGame}" />
                <Button Classes="primary" Content="Resume" Command="{Binding EndPauseCommand}" IsVisible="{Binding Hero.ShowResume}" />
                <Button Content="Skip this one" Command="{Binding SkipCommand}" IsVisible="{Binding Hero.ShowSkip}" />
                <Button Content="Session report" Command="{Binding OpenReportCommand}" IsVisible="{Binding Hero.ShowReport}" />
                <Button Content="Open site" Command="{Binding OpenSiteCommand}" IsVisible="{Binding Hero.ShowOpenSite}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Watched -->
          <Border Classes="panel">
            <StackPanel Spacing="{StaticResource S2_5}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section" Text="Watched" />
                <Button Grid.Column="1" Classes="link" Content="Change…" Command="{Binding ChangeAccountsCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource S2_5}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccountRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource S3}" Background="Transparent"
                          ToolTip.Tip="{Binding Details}">
                        <Viewbox Width="{StaticResource AppFileIcon}" Height="{StaticResource AppFileIcon}">
                          <Canvas Width="{StaticResource AppFileIconBox}" Height="{StaticResource AppFileIconBox}">
                            <Path Data="M22,12 H52 L64,24 V72 H22 Z M52,12 V24 H64" Fill="{StaticResource SurfaceRaisedBrush}"
                                  Stroke="{StaticResource GoldBrush}" StrokeThickness="{StaticResource AppFileIconStroke}" StrokeJoin="Round" />
                          </Canvas>
                        </Viewbox>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Classes="mono" Foreground="{StaticResource TextBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="meta" Text="{Binding Line}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="pill"
                                Classes.fresh="{Binding BadgeTone, Converter={x:Static c:Tones.Fresh}}"
                                Classes.gold="{Binding BadgeTone, Converter={x:Static c:Tones.Gold}}"
                                Classes.warn="{Binding BadgeTone, Converter={x:Static c:Tones.Warn}}">
                          <TextBlock Text="{Binding Badge}" />
                        </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Runs (UP-12, board main-window-runs) -->
          <Border Classes="panel runs" IsVisible="{Binding ShowRuns}" AutomationProperties.Name="Runs">
            <StackPanel Spacing="{StaticResource S2_5}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section" Text="Runs" />
                <Button Grid.Column="1" Classes="link" Content="Open runs on the site" Command="{Binding OpenRunsCommand}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource S3}">
                <Viewbox Width="{StaticResource AppFileIcon}" Height="{StaticResource AppFileIcon}">
                  <Canvas Width="{StaticResource AppRunsIconBox}" Height="{StaticResource AppRunsIconBox}">
                    <Path Classes="runs-icon" Data="M7,6 H21 A3,3 0 0 1 24,9 V21 A3,3 0 0 1 21,24 H7 A3,3 0 0 1 4,21 V9 A3,3 0 0 1 7,6 Z M4,11 H24 M9,3 V8 M19,3 V8" />
                  </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="body-strong" Text="{Binding Runs.Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="meta" Text="{Binding Runs.Line}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" Classes="pill"
                        Classes.reload="{Binding Runs.BadgeKind, Converter={x:Static c:RunsBadges.Reload}}"
                        Classes.warn="{Binding Runs.BadgeKind, Converter={x:Static c:RunsBadges.Warn}}"
                        IsVisible="{Binding Runs.HasBadge}">
                  <TextBlock Text="{Binding Runs.Badge}" />
                </Border>
              </Grid>
              <TextBlock Classes="mono small" Text="{Binding Runs.Path}" IsVisible="{Binding Runs.HasPath}" ToolTip.Tip="{Binding Runs.FullPath}" />
            </StackPanel>
          </Border>

          <!-- How it works: only until the first upload (docs/DESIGN-NOTES.md) -->
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource S2_5}" IsVisible="{Binding !HasRecent}">
            <Border Classes="panel explainer">
              <StackPanel Spacing="{StaticResource S1}">
                <TextBlock Classes="step-number" Text="1" />
                <TextBlock Classes="meta" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Text="You play. The addon collects in the background." />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="panel explainer">
              <StackPanel Spacing="{StaticResource S1}">
                <TextBlock Classes="step-number" Text="2" />
                <TextBlock Classes="meta" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Text="Log out or /reload: the game saves the file." />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="panel explainer">
              <StackPanel Spacing="{StaticResource S1}">
                <TextBlock Classes="step-number" Text="3" />
                <TextBlock Classes="meta" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Text="A few seconds later it's on the site." />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- Recent uploads -->
        <Border Grid.Column="1" Classes="panel" Width="{StaticResource AppAsideW}" AutomationProperties.Name="Recent uploads">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="section" Text="Recent uploads" Margin="{StaticResource AppFooterPad}" />
            <Button DockPanel.Dock="Bottom" Classes="link" HorizontalAlignment="Left" Content="Full history on the site →" Command="{Binding OpenHistoryCommand}" />
            <Panel>
              <TextBlock Classes="meta" Text="No uploads yet. The first one goes up after you play." TextWrapping="Wrap" IsVisible="{Binding !HasRecent}" />
              <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecentRow">
                    <Button Classes="plain" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Summary}">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource S3}">
                          <Ellipse Classes="dot" VerticalAlignment="Center"
                                   Classes.fresh="{Binding Tone, Converter={x:Static c:Tones.Fresh}}"
                                   Classes.dim="{Binding Tone, Converter={x:Static c:Tones.Dim}}"
                                   Classes.stale="{Binding Tone, Converter={x:Static c:Tones.Warn}}" />
                          <TextBlock Grid.Column="1" Classes="label" Text="{Binding When}" />
                          <TextBlock Grid.Column="1" Grid.Row="1" Classes="meta" Text="{Binding Summary}" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CommunitiesForever.Upload.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
        <ResourceInclude Source="/Styles/Themes.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Fluent stays underneath for behaviour; its accent becomes our gold so no Fluent blue shows -->
      <StaticResource x:Key="SystemAccentColor" ResourceKey="Gold" />
      <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="Gold" />
      <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="Gold" />
      <StaticResource x:Key="SystemAccentColorDark3" ResourceKey="Gold" />
      <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="GoldBright" />
      <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="GoldBright" />
      <StaticResource x:Key="SystemAccentColorLight3" ResourceKey="GoldPale" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>
</Application>

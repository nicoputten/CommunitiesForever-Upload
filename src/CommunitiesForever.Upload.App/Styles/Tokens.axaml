  <CornerRadius x:Key="AppStepDotRadius">11</CornerRadius>
  <x:Double x:Key="AppLineThin">1.5</x:Double>
  <Thickness x:Key="AppLineThinThickness">1.5</Thickness>
  <Thickness x:Key="AppSetupMainPad">32,28,32,22</Thickness>
  <x:Double x:Key="AppFsSetupTitle">26</x:Double>
  <x:Double x:Key="AppFsSetupTitleSm">24</x:Double>
  <x:Double x:Key="AppLhLead">1.55</x:Double>
  <x:Double x:Key="AppLsCode">0.18</x:Double>
  <Thickness x:Key="AppCodePad">18,6</Thickness>
  <Thickness x:Key="AppCodeCardPad">16,22</Thickness>
  <x:Double x:Key="AppCheck">18</x:Double>
  <CornerRadius x:Key="AppCheckRadius">5</CornerRadius>
  <x:Double x:Key="AppCheckMark">11</x:Double>
  <Thickness x:Key="AppAccountPad">14,12</Thickness>
  <Thickness x:Key="AppInputPad">10,8</Thickness>
  <Thickness x:Key="AppRowRoomyPad">0,12</Thickness>
  <Thickness x:Key="AppFooterPad">0,12,0,0</Thickness>

  <!-- window background: main-window board, page glow top left over the night -->
  <RadialGradientBrush x:Key="AppWindowBackground" Center="20%,-10%" GradientOrigin="20%,-10%" RadiusX="78%" RadiusY="48%">
    <GradientStop Color="{StaticResource PageGlow}" Offset="0" />
    <GradientStop Color="{StaticResource BgNight}" Offset="0.7" />
  </RadialGradientBrush>
</ResourceDictionary>

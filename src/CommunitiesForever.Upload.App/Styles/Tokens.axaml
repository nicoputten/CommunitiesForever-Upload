<!--
  Design tokens: the web's "Night over Azeroth" tokens (web docs/DESIGN.md §3, src/styles/tokens.css), mirrored.
  The only place in the app with raw colours, sizes, spacing, radii, shadows and durations (CLAUDE.md rule 6).
  Names: the CSS name in PascalCase ("-text-muted" becomes TextMuted), "_" between two numbers ("-s-0-5" becomes S0_5).
  Colours also as <Name>Brush, spacing also as <Name>Thickness.
  TokenDriftTests compares this file with design/tokens/web-tokens.css (refresh: scripts/refresh-tokens.ps1).
  Not mirrored: fonts (embedded below), blur and glow (approved deviation, docs/DESIGN-NOTES.md),
  and the page-specific blocks of tokens.css (roster, map, atmosphere ...).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!-- surfaces -->
  <Color x:Key="BgAbyss">#FF050A12</Color>
  <SolidColorBrush x:Key="BgAbyssBrush" Color="#FF050A12" />

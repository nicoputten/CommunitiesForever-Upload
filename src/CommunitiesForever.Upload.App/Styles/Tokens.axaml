  <!-- elevation -->
  <BoxShadows x:Key="ShadowCard">0 18 40 0 #80000000</BoxShadows>
  <BoxShadows x:Key="ShadowModal">0 30 80 0 #99000000, inset 0 1 0 0 #26F0D08E</BoxShadows>
  <BoxShadows x:Key="ShadowSheet">0 -12 30 0 #73000000</BoxShadows>

  <!-- motion -->
  <sys:TimeSpan x:Key="DurInstant">0:0:0.08</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurFast">0:0:0.12</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurCard">0:0:0.16</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurFan">0:0:0.22</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurZone">0:0:0.25</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurSheet">0:0:0.28</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurDrop">0:0:0.4</sys:TimeSpan>
  <sys:TimeSpan x:Key="DurFly">0:0:0.6</sys:TimeSpan>
  <SplineEasing x:Key="EaseOut" X1="0.2" Y1="0.8" X2="0.2" Y2="1" />
  <SplineEasing x:Key="EaseSpring" X1="0.34" Y1="1.56" X2="0.64" Y2="1" />


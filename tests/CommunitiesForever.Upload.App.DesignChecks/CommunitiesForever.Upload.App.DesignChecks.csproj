<Project Sdk="Microsoft.NET.Sdk">
  <!-- Screenshot design checks (UP-03): rendered with Skia, compared with Baselines/. SkiaSharp comes with Avalonia. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The setup and main window fakes, shared with App.Tests -->
    <Compile Include="..\CommunitiesForever.Upload.App.Tests\Setup\SetupHarness.cs" Link="Setup\SetupHarness.cs" />
    <Compile Include="..\CommunitiesForever.Upload.App.Tests\Main\MainHarness.cs" Link="Main\MainHarness.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CommunitiesForever.Upload.App\CommunitiesForever.Upload.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
</Project>
